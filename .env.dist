# Instances
INSTANCE_FILE="example.json"

# Auth
AUTH_KEY="auth"
# One-time migration of existing accounts: use the former webapp VITE_CRYPT_KEY.
# Remove this value after the first successful sign-in has migrated the account.
AUTH_LEGACY_CRYPT_KEY=

# Flix App
FLIX_APP_URL=

# Docker
NODE_ENV=development
API_PORT=3051
API_IMAGE=flix_api
API_DOCKERFILE=Dockerfile
REDIS_PORT=6380
REDIS_PASSWORD=

# Deploy agent (production)
DEPLOY_TOKEN=change-me
DEPLOY_AGENT_PORT=9009
REGISTRY_URL=
REGISTRY_USER=
REGISTRY_PASSWORD=
