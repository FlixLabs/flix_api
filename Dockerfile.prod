FROM node:24.22.1-bookworm-slim AS build

WORKDIR /api

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --production=true

COPY . .
RUN yarn test

FROM node:24.22.1-bookworm-slim

WORKDIR /api

ENV NODE_ENV=production

COPY --from=build /api /api

EXPOSE 3000

CMD ["yarn", "start"]
